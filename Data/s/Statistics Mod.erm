ZVSE2
; Statistics Mod 0.3
; Requires: ERA 3 and Era Erm Framework
; Open the statistics table by right-clicking the Quest Log button or with Shift + right-click on an empty map tile.

!#DC(STATS_TABLE_DLG) = 711;

; =============================================================================
; PLAY TIME PER PLAYER
; =============================================================================

!?FU(Stats_Get_Local_Minute);
; x1 = calculated local time in minutes
!!FU(gem_GetLocalTime):P?y1/?y2/?y3/?y4/?y5/?y6;
!!VRx1:Sy1 *12 +y2 *30 +y4 *24 +y5 *60 +y6;

!?FU(Stats_Save_Turn_Start);
!!OW:C?y1;
!!FU|y1<0/y1>7:E;
!!FU(Stats_Get_Local_Minute):P?y2;
!!SN:W^Stats_Player_%Y1_Turn_Start_Minute^/y2;

!?FU(OnStartOrLoad);
!!FU(Stats_Save_Turn_Start):P;
!!FU(Stats_Init_All_Resource_Snapshots):P;

!?FU(OnEveryDay);
!!FU(Stats_Save_Turn_Start):P;

!?FU(WOG_EndOfTurn);
!!OW:C?y1;
!!FU|y1<0/y1>7:E;
!!FU(Stats_Get_Local_Minute):P?y2;
!!SN:W^Stats_Player_%Y1_Turn_Start_Minute^/?y3;
!!VRy4:Sy2-y3;
!!SN&y4>=0/y4<60:W^Stats_Player_%Y1_Game_Time_Minutes^/dy4;
!!FU(Stats_Update_Player_Resources):Py1;
!!SN&y4>=0/y4<60:W^Stats_Player_%Y1_Turns_Completed^/d1;

!?FU(Stats_Get_Player_Time);
; x1 = player, x2 = returned active play time in minutes
!!SN:W^Stats_Player_%X1_Game_Time_Minutes^/?x2;
!!FU(Stats_Get_Local_Minute):P?y1;
!!SN:W^Stats_Player_%X1_Turn_Start_Minute^/?y2;
!!VRy3:Sy1-y2;
!!VRx2&y3>=0/y3<60:+y3;

!?FU(Stats_Get_Average_Turn_Time);
; x1 = player, x2 = average duration of completed turns in minutes
!!VRx2:S0;
!!SN:W^Stats_Player_%X1_Turns_Completed^/?y1;
!!FU&y1<=0:E;
!!SN:W^Stats_Player_%X1_Game_Time_Minutes^/?x2;
!!VRx2::y1;

; =============================================================================
; APPROXIMATE PLAYER ECONOMY
; Resource changes are sampled when a dialog opens and at the end of each turn.
; =============================================================================

!?FU(Stats_Init_Player_Resource_Snapshot);
; x1 = player
!!FU|x1<0/x1>7:E;
!!SN:W^Stats_Player_%X1_Resource_Snapshot_Initialized^/?y1;
!!FU&y1=1:E;
!!re i/0/7;
  !!OW:Rx1/i/?y2;
  !!SN:W^Stats_Player_%X1_Resource_%i_Snapshot^/y2;
!!en;
!!SN:W^Stats_Player_%X1_Resource_Snapshot_Initialized^/1;

!?FU(Stats_Init_All_Resource_Snapshots);
!!re i/0/7;
  !!FU(Stats_Init_Player_Resource_Snapshot):Pi;
!!en;

!?FU(Stats_Update_Player_Resources);
; x1 = player. Positive net changes count as collected; negative gold changes count as spent.
!!FU|x1<0/x1>7:E;
!!SN:W^Stats_Player_%X1_Resource_Snapshot_Initialized^/?y1;
!!if&y1=0;
  !!FU(Stats_Init_Player_Resource_Snapshot):Px1;
!!el;
  !!re i/0/7;
    !!OW:Rx1/i/?y2;
    !!SN:W^Stats_Player_%X1_Resource_%i_Snapshot^/?y3;
    !!VRy4:Sy2-y3;
    !!SN&i<>6/y4>0:W^Stats_Player_%X1_Resources_Collected^/dy4;
    !!SN&i=6/y4>0:W^Stats_Player_%X1_Gold_Collected^/dy4;
    !!VRy5:Sy4*-1;
    !!SN&i=6/y5>0:W^Stats_Player_%X1_Gold_Spent^/dy5;
    !!SN:W^Stats_Player_%X1_Resource_%i_Snapshot^/y2;
  !!en;
!!en;

; =============================================================================
; CREATURES RECRUITED IN TOWNS
; Compare all seven town dwelling populations. This also detects purchases made
; through HD Mod's Buy All button, which does not emit an ERM recruitment event.
; =============================================================================

!?FU(Stats_Store_Town_Dwelling_Snapshot);
; x1 = town ID
!!FU&x1<0:E;
!!re i/0/6;
  !!CA0/x1:M1/i/?y1/?y2;
  !!VRy1&y1<0:S0;
  !!VRy2&y2<0:S0;
  !!VRy3:Sy1;
  !!VRy3&y2>y3:Sy2;
  !!SN:W^Stats_Town_Dwelling_Snapshot_%i^/y3;
!!en;
!!VRi^Stats_Recruitment_Town^:Sx1;
!!VRi^Stats_Recruitment_Snapshot_Ready^:S1;

!?FU(Stats_Compare_Town_Dwelling_Snapshot);
; x1 = town ID
!!FU&i^Stats_Recruitment_Snapshot_Ready^<>1:E;
!!FU&x1<>i^Stats_Recruitment_Town^:E;
!!CA0/x1:O?y1;
!!FU|y1<0/y1>7:E;
!!VRy2:S0;
!!re i/0/6;
  !!CA0/x1:M1/i/?y3/?y4;
  !!VRy3&y3<0:S0;
  !!VRy4&y4<0:S0;
  !!VRy5:Sy3;
  !!VRy5&y4>y5:Sy4;
  !!SN:W^Stats_Town_Dwelling_Snapshot_%i^/?y6;
  !!VRy7:Sy6 -y5;
  !!VRy2&y7>0:+y7;
  !!SN:W^Stats_Town_Dwelling_Snapshot_%i^/y5;
!!en;
!!SN&y2>0:W^Stats_Player_%Y1_Creatures_Recruited^/dy2;

; Store the populations when entering a town. Compare after every processed
; town click and once more on exit in case a custom button bypasses ERM clicks.
!?FU(OnOpenTownScreen);
!#VA(townId:x);
!!FU(Stats_Store_Town_Dwelling_Snapshot):P(townId);

!?FU(OnTownMouseClick_Quit);
!!FU(Stats_Compare_Town_Dwelling_Snapshot)&i^Stats_Recruitment_Snapshot_Ready^=1:Pi^Stats_Recruitment_Town^;

!?FU(OnCloseTownScreen);
!!FU(Stats_Compare_Town_Dwelling_Snapshot)&i^Stats_Recruitment_Snapshot_Ready^=1:Pi^Stats_Recruitment_Town^;
!!VRi^Stats_Recruitment_Snapshot_Ready^:S0;

; =============================================================================
; CREATURES RECRUITED FROM EXTERNAL DWELLINGS
; Compare the available populations before and after visiting map dwelling
; types 17 and 20. Up to four offered creature stacks are supported.
; =============================================================================

!?FU(Stats_Store_External_Dwelling_Snapshot);
; x1/x2/x3 = dwelling coordinates
!!VRi^Stats_External_Dwelling_Snapshot_Ready^:S0;
!!HE-1:O?y1;
!!FU|y1<0/y1>7:E;
!!VRi^Stats_External_Dwelling_Player^:Sy1;
!!re i/0/3;
  !!VRy2:S-1; !!VRy3:S0;
  !!DWx1/x2/x3:Mi/?y2/?y3;
  !!VRy3|y2<0/y3<0:S0;
  !!SN:W^Stats_External_Dwelling_Start_%i^/y3;
!!en;
!!VRi^Stats_External_Dwelling_Snapshot_Ready^:S1;

!?FU(Stats_Compare_External_Dwelling_Snapshot);
; x1/x2/x3 = dwelling coordinates
!!FU&i^Stats_External_Dwelling_Snapshot_Ready^<>1:E;
!!VRy1:Si^Stats_External_Dwelling_Player^;
!!VRy10:S0;
!!re i/0/3;
  !!VRy2:S-1; !!VRy3:S0;
  !!DWx1/x2/x3:Mi/?y2/?y3;
  !!VRy3|y2<0/y3<0:S0;
  !!SN:W^Stats_External_Dwelling_Start_%i^/?y4;
  !!VRy5:Sy4-y3;
  !!VRy10&y5>0:+y5;
!!en;
!!SN&y1>=0/y1<=7/y10>0:W^Stats_Player_%Y1_External_Dwelling_Recruits^/dy10;
!!VRi^Stats_External_Dwelling_Snapshot_Ready^:S0;

!?OB17;
!!FU(Stats_Store_External_Dwelling_Snapshot):Pv998/v999/v1000;

!$OB17;
!!FU(Stats_Compare_External_Dwelling_Snapshot):Pv998/v999/v1000;

!?OB20;
!!FU(Stats_Store_External_Dwelling_Snapshot):Pv998/v999/v1000;

!$OB20;
!!FU(Stats_Compare_External_Dwelling_Snapshot):Pv998/v999/v1000;

; =============================================================================
; ADVENTURE-MAP SPELLS
; =============================================================================

!?MG1;
!!VRy1:Sv997;                           [Spell ID cast on the adventure map]
!!FU|y1<0/y1>69:E;                     [Exit if no valid spell was cast]
!!SSy1:F?y2;                            [Get spell flags]
!!VRy3:Sy2;
!!VRy3:&2;                              [0x00000002 = map spell]
!!FU&y3=0:E;
!!OW:C?y4;
!!OW:Ay4/?y5;                           [Active hero of current player]
!!FU|y5<0/y5>155:E;
!!SN:W^Stats_Hero_%Y5_Adventure_Spells^/d1;

; =============================================================================
; TEMPORARY BATTLE STATISTICS
; Ordinary battle values are committed after battle and rolled back if the
; battle is replayed. Permanent ACM spell upgrades are deliberately retained.
; =============================================================================

!?FU(Stats_Reset_Battle_Hero);
; x1 = hero ID
!!FU|x1<0/x1>155:E;
!!SN:W^Stats_Temp_Hero_%X1_Physical_Damage^/0;
!!SN:W^Stats_Temp_Hero_%X1_Melee_Damage^/0;
!!SN:W^Stats_Temp_Hero_%X1_Ranged_Damage^/0;
!!SN:W^Stats_Temp_Hero_%X1_Commander_Damage^/0;
!!SN:W^Stats_Temp_Hero_%X1_Magic_Damage^/0;
!!SN:W^Stats_Temp_Hero_%X1_Combat_Spells^/0;
!!SN:W^Stats_Temp_Hero_%X1_Commander_Casts^/0;
!!SN:W^Stats_Temp_Hero_%X1_Spell_Upgrades^/0;
!!SN:W^Stats_Temp_Hero_%X1_Enemy_Creatures_Killed^/0;
!!SN:W^Stats_Temp_Hero_%X1_Lost_Units^/0;
!!SN:W^Stats_Temp_Hero_%X1_Mana_Spent^/0;
!!SN:W^Stats_Temp_Hero_%X1_Mana_Before_Cast^/0;
!!SN:W^Stats_Temp_Hero_%X1_Mana_Cast_Pending^/0;
!!SN:W^Stats_Temp_Hero_%X1_Enemy_Heroes_Defeated^/0;
!!SN:W^Stats_Temp_Hero_%X1_Max_Physical_Hit^/0;
!!SN:W^Stats_Temp_Hero_%X1_Max_Magic_Hit^/0;
!!SN:W^Stats_Temp_Hero_%X1_Previous_Max_Physical_Hit^/0;
!!SN:W^Stats_Temp_Hero_%X1_Previous_Max_Magic_Hit^/0;
!!SN:W^Stats_Temp_Hero_%X1_Committed^/0;

!?FU(Stats_Store_Battle_Army);
; x1 = hero ID. Store all seven army slots before combat.
!!FU|x1<0/x1>155:E;
!!re i/0/6;
  !!VRy1:S-1; !!VRy2:S0;
  !!HEx1:C0/i/?y1/?y2;
  !!VRy2|y1<0/y2<0:S0;
  !!SN:W^Stats_Temp_Hero_%X1_Army_Start_Type_%i^/y1;
  !!SN:W^Stats_Temp_Hero_%X1_Army_Start_Count_%i^/y2;
!!en;

!?FU(Stats_Calculate_Battle_Lost_Units);
; x1 = hero ID. Compare the surviving army with the pre-battle snapshot.
!!FU|x1<0/x1>155:E;
!!VRy10:S0;
!!re i/0/6;
  !!SN:W^Stats_Temp_Hero_%X1_Army_Start_Type_%i^/?y1;
  !!SN:W^Stats_Temp_Hero_%X1_Army_Start_Count_%i^/?y2;
  !!VRy3:S-1; !!VRy4:S0;
  !!HEx1:C0/i/?y3/?y4;
  !!VRy4|y3<0/y4<0:S0;
  !!VRy5:Sy2;
  !!VRy5&y1=y3:-y4;
  !!VRy5&y5<0:S0;
  !!VRy10:+y5;
!!en;
!!SN:W^Stats_Temp_Hero_%X1_Lost_Units^/y10;

!?FU(OnBeforeBattleUniversal);
!!BA:H0/?y1 H1/?y2;
!!VRi^Stats_Battle_Hero_0^:Sy1;
!!VRi^Stats_Battle_Hero_1^:Sy2;
!!VRi^Stats_Battle_Replay_Hero^:S-1;
!!OW:C?y3;
!!if&y1>=0/y1<=155;
  !!HEy1:O?y4;
  !!VRi^Stats_Battle_Replay_Hero^&y4=y3:Sy1;
!!en;
!!if&i^Stats_Battle_Replay_Hero^<0/y2>=0/y2<=155;
  !!HEy2:O?y4;
  !!VRi^Stats_Battle_Replay_Hero^&y4=y3:Sy2;
!!en;
!!VRi^Stats_Actual_Magic_Action^:S0;
!!FU(Stats_Reset_Battle_Hero):Py1;
!!FU(Stats_Reset_Battle_Hero):Py2;
!!FU(Stats_Store_Battle_Army):Py1;
!!FU(Stats_Store_Battle_Army):Py2;

; Snapshot ACM's independent side counters after battle setup.
!?FU(OnAfterBattleSetup);
!!SN:W^Stats_Spell_Upgrade_Counter_Start_0^/0;
!!SN:W^Stats_Spell_Upgrade_Counter_Start_1^/0;
!!FU&i^Advanced_Classes_Mod_Active^<>1:E;
!!SN:W^ACM_Trainer_Upgrade_Counter_0^/?y1;
!!SN:W^Stats_Spell_Upgrade_Counter_Start_0^/y1;
!!SN:W^ACM_Trainer_Upgrade_Counter_1^/?y1;
!!SN:W^Stats_Spell_Upgrade_Counter_Start_1^/y1;

!?FU(Stats_Record_Battle_Spell_Upgrades);
!!FU&i^Advanced_Classes_Mod_Active^<>1:E;
!!FU(Stats_Record_Side_Spell_Upgrades):P0/i^Stats_Battle_Hero_0^;
!!FU(Stats_Record_Side_Spell_Upgrades):P1/i^Stats_Battle_Hero_1^;

!?FU(Stats_Record_Side_Spell_Upgrades);
; x1 = battle side, x2 = hero. Count each human hero's own upgrades.
!!FU|x2<0/x2>155:E;
!!HEx2:O?y4;
!!FU|y4<0/y4>7:E;
!!OW:Iy4/?y5;
!!FU&y5=1:E;
!!SN:W^ACM_Trainer_Upgrade_Counter_%X1^/?y2;
!!SN:W^Stats_Spell_Upgrade_Counter_Start_%X1^/?y3;
!!VRy3:Sy2 -y3;
!!VRy3&y3<0:S0;
!!SN:W^Stats_Temp_Hero_%X2_Spell_Upgrades^/y3;

; Count spells cast by an ACM/WoG commander (creature IDs 174-191).
!?FU(OnBeforeBattleAction);
!!BG:A?y1;
!!FU&y1<>10:E;                          [Only creature spell actions]
!!BG:S?y2 N?y3 H?y4;
!!FU&y2<>-1:E;                          [Only an actual creature spell cast]
!!FU|y3<0/y3>41/y4<0/y4>155:E;
!!BMy3:T?y5;
!!FU|y5<174/y5>191:E;                  [WoG commander creature IDs]
!!SN:W^Stats_Temp_Hero_%Y4_Commander_Casts^/d1;

; Count one hero spell action. Damage from that spell is collected separately by MR1.
!?BG0;
!!BG:A?y1 S?y2 H?y3;
!!VRi^Stats_Actual_Magic_Action^:S0;
!!VRi^Stats_Actual_Magic_Action^|y1=1/y1=10:S1;
!!FU&y1<>1:E;                           [Only hero spell actions]
!!FU|y3<0/y3>155:E;
!!SSy2:F?y4;
!!VRy5:Sy4;
!!VRy5:&1;                              [0x00000001 = battlefield spell]
!!FU&y5=0:E;
!!SN:W^Stats_Temp_Hero_%Y3_Combat_Spells^/d1;
!!HEy3:I?y6;
!!SN:W^Stats_Temp_Hero_%Y3_Mana_Before_Cast^/y6;
!!SN:W^Stats_Temp_Hero_%Y3_Mana_Cast_Pending^/1;

; Store the real spell-point difference after a hero spell action.
!?FU(Stats_Record_Mana_After_Action);
; x1 = hero ID
!!FU|x1<0/x1>155:E;
!!SN:W^Stats_Temp_Hero_%X1_Mana_Cast_Pending^/?y1;
!!FU&y1=0:E;
!!HEx1:I?y2;
!!SN:W^Stats_Temp_Hero_%X1_Mana_Before_Cast^/?y3;
!!VRy4:Sy3-y2;
!!SN&y4>0:W^Stats_Temp_Hero_%X1_Mana_Spent^/dy4;
!!SN:W^Stats_Temp_Hero_%X1_Mana_Cast_Pending^/0;

!?BG1;
!!FU(Stats_Record_Mana_After_Action):Pi^Stats_Battle_Hero_0^;
!!FU(Stats_Record_Mana_After_Action):Pi^Stats_Battle_Hero_1^;
!!VRi^Stats_Actual_Magic_Action^:S0;

; Record casualties caused by one side for the opposing hero.
!?FU(Stats_Record_Damage_Event);
; x1 = target stack, x2 = reported damage
!!FU|x1<0/x1>41/x2<=0:E;
!!BMx1:N?y1 H?y2 L?y3 I?y4;
!!FU|y1<=0/y2<=0/y4<0/y4>1:E;
!!VRy5:Sy1*y2-y3;                     [Current total hit points of the target stack]
!!VRy6:Sx2;
!!VRy6&y6>y5:Sy5;                    [Ignore overkill damage]
!!FU&y6<=0:E;

!!VRy8:Sy6+y3 :y2;                   [Creatures killed by this damage event]
!!VRy8&y8>y1:Sy1;
!!FU&y8<=0:E;
!!VRy9:Si^Stats_Battle_Hero_1^;
!!VRy9&y4=1:Si^Stats_Battle_Hero_0^; [Opposing hero receives the kill credit]
!!SN&y9>=0/y9<=155:W^Stats_Temp_Hero_%Y9_Enemy_Creatures_Killed^/dy8;

!?MR1;
!!FU&i^Stats_Actual_Magic_Action^=0:E;
!!MR:N?y1 F?y2;
!!FU(Stats_Record_Damage_Event):Py1/y2;

; Physical damage caused by real attacks and shots. Unlike MF1, this event
; explicitly identifies theoretical AI and mouse-hint calculations.
!?FU(OnStackToStackDamage_Quit);
!#VA(atkStack:x) (defStack:x) (finalDmgConst:x) (finalDmg:x) (basicDmg:x) (dmgBonus:x) (isDistant:x) (distanceArg:x) (isTheoretical:x);
!!FU|(isTheoretical)/(finalDmg)<=0:E;
!!FU|(atkStack)<0/(atkStack)>41/(defStack)<0/(defStack)>41:E;
!!BM(atkStack):I?(atkSide:y) T?(atkType:y);
!!FU|(atkSide)<0/(atkSide)>1:E;
!!VR(hero:y):Si^Stats_Battle_Hero_0^;
!!VR(hero)&(atkSide)=(BATTLE_RIGHT):Si^Stats_Battle_Hero_1^;
!!FU|(hero)<0/(hero)>155:E;
!!BM(defStack):N?(defNum:y) H?(defHp:y) L?(defLostHp:y);
!!VR(actualDmg:y):S(defNum) *(defHp) -(defLostHp);
!!VR(actualDmg)&(finalDmg)<(actualDmg):S(finalDmg);
!!FU&(actualDmg)<=0:E;
!!SN:W^Stats_Temp_Hero_%(hero)_Physical_Damage^/?(physicalTotal:y);
!!VR(physicalTotal):+(actualDmg);
!!SN:W^Stats_Temp_Hero_%(hero)_Physical_Damage^/(physicalTotal);
!!if&(isDistant)=(FALSE);
  !!SN:W^Stats_Temp_Hero_%(hero)_Melee_Damage^/?(meleeTotal:y);
  !!VR(meleeTotal):+(actualDmg);
  !!SN:W^Stats_Temp_Hero_%(hero)_Melee_Damage^/(meleeTotal);
!!el;
  !!SN:W^Stats_Temp_Hero_%(hero)_Ranged_Damage^/?(rangedTotal:y);
  !!VR(rangedTotal):+(actualDmg);
  !!SN:W^Stats_Temp_Hero_%(hero)_Ranged_Damage^/(rangedTotal);
!!en;
!!if&(atkType)>=174/(atkType)<=191;
  !!SN:W^Stats_Temp_Hero_%(hero)_Commander_Damage^/?(commanderTotal:y);
  !!VR(commanderTotal):+(actualDmg);
  !!SN:W^Stats_Temp_Hero_%(hero)_Commander_Damage^/(commanderTotal);
!!en;
!!SN:W^Stats_Temp_Hero_%(hero)_Max_Physical_Hit^/?(oldMax:y);
!!SN&(actualDmg)>(oldMax):W^Stats_Temp_Hero_%(hero)_Max_Physical_Hit^/(actualDmg);
!!FU(Stats_Record_Damage_Event):P(defStack)/(actualDmg);

; Damage caused directly by a hero spell.
!?MR1;
!!BG:A?y1;
!!FU&y1<>1:E;                           [Ignore creature and commander spell damage]
!!MR:N?y2 F?y3;
!!FU&y3<=0:E;
!!BG:H?y4;
!!FU|y4<0/y4>155:E;
!!BMy2:N?y5 H?y6 L?y7;
!!VRy5:*y6-y7;
!!VRy3&y3>y5:Sy5;                      [Do not count overkill damage]
!!FU&y3<=0:E;
!!SN:W^Stats_Temp_Hero_%Y4_Magic_Damage^/dy3;
!!SN:W^Stats_Temp_Hero_%Y4_Max_Magic_Hit^/?y8;
!!SN&y3>y8:W^Stats_Temp_Hero_%Y4_Max_Magic_Hit^/y3;

; Direct damage caused by a WoG/ACM commander spell.
!?MR1;
!!BG:A?y1;
!!FU&y1<>10:E;                          [Only creature spell actions]
!!MR:N?y2 F?y3;
!!FU&y3<=0:E;
!!BG:H?y4 N?y8;
!!FU|y4<0/y4>155/y8<0/y8>41:E;
!!BMy8:T?y9;
!!FU|y9<174/y9>191:E;                  [WoG commander creature IDs]
!!BMy2:N?y5 H?y6 L?y7;
!!VRy5:*y6-y7;
!!VRy3&y3>y5:Sy5;                      [Do not count overkill damage]
!!SN&y3>0:W^Stats_Temp_Hero_%Y4_Commander_Damage^/dy3;

; Determine whether one hero defeated another hero in this battle.
!?FU(Stats_Record_Defeated_Hero);
!!VRy1:Si^Stats_Battle_Hero_0^;
!!VRy2:Si^Stats_Battle_Hero_1^;
!!FU|y1<0/y1>155/y2<0/y2>155:E;       [Both sides must have a hero]
!!HEy1:O?y3;
!!HEy2:O?y4;
!!SN&y3>=0/y4<0:W^Stats_Temp_Hero_%Y1_Enemy_Heroes_Defeated^/1;
!!SN&y4>=0/y3<0:W^Stats_Temp_Hero_%Y2_Enemy_Heroes_Defeated^/1;

!?FU(Stats_Commit_Battle_Hero);
; x1 = hero ID
!!FU|x1<0/x1>155:E;
!!SN:W^Stats_Temp_Hero_%X1_Committed^/?y1;
!!FU&y1=1:E;
!!SN:W^Stats_Temp_Hero_%X1_Physical_Damage^/?y2;
!!SN:W^Stats_Temp_Hero_%X1_Melee_Damage^/?y27;
!!SN:W^Stats_Temp_Hero_%X1_Ranged_Damage^/?y28;
!!SN:W^Stats_Temp_Hero_%X1_Commander_Damage^/?y31;
!!SN:W^Stats_Temp_Hero_%X1_Magic_Damage^/?y3;
!!SN:W^Stats_Temp_Hero_%X1_Combat_Spells^/?y4;
!!SN:W^Stats_Temp_Hero_%X1_Commander_Casts^/?y23;
!!SN:W^Stats_Temp_Hero_%X1_Spell_Upgrades^/?y24;
!!SN:W^Stats_Temp_Hero_%X1_Max_Physical_Hit^/?y5;
!!SN:W^Stats_Temp_Hero_%X1_Max_Magic_Hit^/?y6;
!!SN:W^Stats_Temp_Hero_%X1_Enemy_Creatures_Killed^/?y11;
!!SN:W^Stats_Temp_Hero_%X1_Lost_Units^/?y12;
!!SN:W^Stats_Temp_Hero_%X1_Mana_Spent^/?y13;
!!SN:W^Stats_Temp_Hero_%X1_Enemy_Heroes_Defeated^/?y14;
