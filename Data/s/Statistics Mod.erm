!?FU(OnAdventureMapRightMouseClick)&i^mouse_item^=(ITEM_ADVMAP_ADVENTURE_MAP)/i^key_shift^/i^key_ctrl^;
!!CM:R(FALSE);
!!FU(Stats_Open_Table_Dialog):P;

